@model Game_Manager_Elite.Models.ApaTeam

@{
    ViewData["Title"] = "Team Details";
}

<div class="container py-4">
    <div class="card shadow-sm border-0 max-width-md mx-auto" style="max-width: 600px; background: #ffffff; border-radius: 12px; padding: 30px;">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="fw-bold m-0" style="color: #111827;">@Html.DisplayFor(model => model.TeamName)</h2>
                <p class="text-muted m-0 small">APA League Record Specifications</p>
            </div>
            <span class="badge @(Model.Format.ToString() == "EightBall" ? "bg-primary" : "bg-success") px-3 py-2 fs-6">
                @(Model.Format.ToString() == "EightBall" ? "8-Ball" : "9-Ball")
            </span>
        </div>

        <div class="border-top pt-3">
            <dl class="row mb-0 g-3">
                <dt class="col-sm-4 text-secondary small text-uppercase fw-bold">Division</dt>
                <dd class="col-sm-8 fw-semibold text-dark">@Html.DisplayFor(model => model.DivisionNumber)</dd>

                <dt class="col-sm-4 text-secondary small text-uppercase fw-bold">Host Location</dt>
                <dd class="col-sm-8 text-dark">@Html.DisplayFor(model => model.HostLocation)</dd>

                <dt class="col-sm-4 text-secondary small text-uppercase fw-bold">Active Session</dt>
                <dd class="col-sm-8 text-dark">@Html.DisplayFor(model => model.Session)</dd>

                <dt class="col-sm-4 text-secondary small text-uppercase fw-bold">League Year</dt>
                <dd class="col-sm-8 text-dark">@Html.DisplayFor(model => model.Year)</dd>

                <dt class="col-sm-4 text-secondary small text-uppercase fw-bold">Total Points</dt>
                <dd class="col-sm-8 fw-bold text-primary">@Html.DisplayFor(model => model.TotalPoints)</dd>
            </dl>
        </div>

        <!-- Dashboard Action Footers -->
        <div class="d-flex align-items-center gap-3 border-top pt-4 mt-4">
            <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-primary px-4 fw-semibold" style="background-color: #2563eb; border: none; padding: 10px 20px;">
                <i class="bi bi-pencil-square me-1"></i> Edit Team
            </a>
            <a asp-controller="ApaDashboard" asp-action="Index" class="btn btn-outline-secondary px-4 fw-semibold" style="padding: 10px 20px;">
                Back to Dashboard
            </a>
        </div>

    </div>
</div>
