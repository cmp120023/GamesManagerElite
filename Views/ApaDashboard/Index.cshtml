@model IEnumerable<Game_Manager_Elite.Models.ApaTeam>

@{
    ViewData["Title"] = "APA League Dashboard";
}

<div class="container py-4">
    <!-- Dashboard Header and Actions Nav Row -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 pb-4 mb-4 border-bottom">
        <div>
            <h1 class="fw-bold m-0 text-dark">APA League Dashboard</h1>
            <p class="text-muted m-0 small">Active Session Hub & Roster Management Workspace</p>
        </div>

        <!-- Dashboard Sub-Navigation Action Component Blocks -->
        <div class="d-flex flex-wrap gap-2">
            <a asp-controller="ApaStandings" asp-action="Index" class="btn btn-outline-warning d-flex align-items-center gap-2 px-3">
                <i class="bi bi-trophy-fill text-warning"></i> Standings
            </a>
            <a asp-controller="ApaPlayers" asp-action="Index" class="btn btn-outline-info d-flex align-items-center gap-2 px-3">
                <i class="bi bi-people-fill text-info"></i> Players
            </a>
            <a asp-controller="ApaMatches" asp-action="Index" class="btn btn-outline-secondary d-flex align-items-center gap-2 px-3">
                <i class="bi bi-clock-history"></i> Match History
            </a>
            <a asp-controller="ApaTeams" asp-action="Create" class="btn btn-primary d-flex align-items-center gap-2 px-3 fw-semibold" style="background-color: #2563eb; border: none;">
                <i class="bi bi-plus-circle-fill"></i> Add New Team
            </a>
        </div>
    </div>

    <!-- Active Teams Grid Workspace -->
    <h4 class="fw-bold mb-3 text-secondary small text-uppercase tracking-wider">Registered Teams</h4>
    <div class="row g-4">
        @if (!Model.Any())
        {
            <div class="col-12">
                <div class="alert alert-info border-0 shadow-sm rounded-3 py-4 text-center">
                    <i class="bi bi-info-circle-fill fs-2 mb-2 d-block text-info"></i>
                    <p class="mb-0 fw-medium">No teams registered for this session yet.</p>
                    <a asp-controller="ApaTeams" asp-action="Create" class="btn btn-primary btn-sm mt-3 px-3">Create First Team</a>
                </div>
            </div>
        }
        else
        {
            @foreach (var team in Model)
            {
                <div class="col-md-4 col-sm-6">
                    <div class="card h-100 shadow-sm border-0 position-relative p-2" style="border-radius: 12px; background: #ffffff;">
                        <div class="card-body d-flex flex-column">
                            <!-- Team Title and Format Badge Row -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="fw-bold m-0 text-truncate pe-2" style="color: #2563eb;">@team.TeamName</h5>
                                <span class="badge @(team.Format.ToString() == "EightBall" ? "bg-primary" : "bg-success") btn-sm px-2">
                                    @(team.Format.ToString() == "EightBall" ? "8-Ball" : "9-Ball")
                                </span>
                            </div>

                            <!-- Team Metadata Fields -->
                            <div class="text-muted small mb-3 flex-grow-1">
                                <div class="mb-1"><i class="bi bi-geo-alt-fill me-1 small"></i> @team.HostLocation</div>
                                <div class="mb-1"><i class="bi bi-layers-fill me-1 small"></i> Division @team.DivisionNumber</div>
                                <div class="mb-1"><i class="bi bi-calendar3 me-1 small"></i> @team.Session @team.Year</div>
                            </div>

                            <!-- Roster Tracker Metrics Line -->
                            <div class="border-top pt-2 mb-3">
                                <span class="fw-bold text-dark d-block">Roster Count: @team.Roster.Count</span>
                                <small class="text-muted">players registered</small>
                            </div>

                            <!-- Actions Deep-Link Row -->
                            <a asp-controller="ApaTeams" asp-action="Details" asp-route-id="@team.Id" class="btn btn-outline-primary w-100 btn-sm fw-semibold" style="border-radius: 6px;">
                                View Team Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
