@model IEnumerable<Game_Manager_Elite.Models.BcaPlayer>

@* 
Summary: Player Directory View - Renders a searchable, alphabetized table of all registered league players showing their handicap rating badges and team affiliations.
*@

@{
    ViewData["Title"] = "BCA Player Rosters";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>BCA League Player Directory</h2>
        <div>
            <a asp-action="AddPlayer" class="btn btn-primary">+ Add New Player</a>
            <a asp-action="Index" class="btn btn-outline-secondary">Dashboard</a>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            No players registered yet. Click "Add New Player" to add your first shooter!
        </div>
    }
    else
    {
        <div class="table-responsive shadow-sm">
            <table class="table table-striped table-hover align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th>Player Name</th>
                        <th class="text-center">Handicap Rating</th>
                        <th>Assigned Team</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var player in Model)
                    {
                        <tr>
                            <td class="fw-bold">@player.FirstName @player.LastName</td>
                            <td class="text-center">
                                <span class="badge bg-info text-dark">Rating: @player.HandicapRating</span>
                            </td>
                            <td>
                                @if (player.Team != null)
                                {
                                    <span class="badge bg-primary">@player.Team.TeamName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Free Agent</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>