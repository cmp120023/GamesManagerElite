@model Game_Manager_Elite.Models.BcaTeam

@* 
Summary: Create Team View - Provides a card-based form for league administrators to input team name and division, complete with client-side model validation.
*@

@{
    ViewData["Title"] = "Create BCA Team";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">Add New BCA Team</h4>
                </div>
                <div class="card-body">
                    <form asp-action="CreateTeam" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TeamName" class="form-label font-weight-bold"></label>
                            <input asp-for="TeamName" class="form-control" placeholder="e.g., Cue Tacos" />
                            <span asp-validation-for="TeamName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Division" class="form-label font-weight-bold"></label>
                            <input asp-for="Division" class="form-control" placeholder="e.g., Tuesday 8-Ball" />
                            <span asp-validation-for="Division" class="text-danger"></span>
                        </div>

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-secondary">Back to Dashboard</a>
                            <button type="submit" class="btn btn-success">Save Team</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}